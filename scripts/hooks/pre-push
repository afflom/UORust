#!/usr/bin/env bash
# Refuse a push to main that bootstrap or core.yml would refuse, before it
# lands: rustfmt and xtask's R1, R4 and R5 gates (validate's but
# audit-bootstrap, which needs the SDK), and,
# when the push touches the MIR path (crates/uorust/src/mir), the core
# register's ratchet on CI's own MIR (scripts/mir/core-gate.sh). Runs in the
# pushing worktree with that lane's own build. Installed by
# `git config core.hooksPath scripts/hooks` (`just hooks`); needs no `just`.
# The lane's cargo flags come from scripts/hooks/lane-cfg.sh ($LANE_N).
set -euo pipefail
zero=0000000000000000000000000000000000000000
# Every ref line first, so nothing the gates run reads them from stdin.
pushed=$(cat)
while read -r _lref lsha rref rsha; do
  [ -n "$rref" ] || continue
  [ "$rref" = refs/heads/main ] || continue
  [ "$lsha" = "$zero" ] && continue
  root=$(git rev-parse --show-toplevel)
  cd "$root"
  . "$root/scripts/hooks/lane-cfg.sh"
  cargo fmt --all -- --check >/dev/null || { echo "pre-push: cargo fmt --check fails; run cargo fmt" >&2; exit 1; }
  # validate's gates but audit-bootstrap, which reads the SDK's inventory
  # and so runs only inside the SDK (bootstrap runs it).
  for gate in check-model audit-limits audit-deferral audit-dependency-updates; do
    cargo run -q --locked -p xtask "${cfg[@]}" -- "$gate" \
      || { echo "pre-push: xtask $gate refuses this tree" >&2; exit 1; }
  done
  # What the push adds to main: from the remote's main when this clone has
  # it, else from the last fetched origin/main.
  base=$rsha
  if [ "$base" = "$zero" ] || ! git cat-file -e "$base^{commit}" 2>/dev/null; then
    base=$(git merge-base origin/main "$lsha")
  fi
  if [ -n "$(git diff --name-only "$base" "$lsha" -- crates/uorust/src/mir)" ]; then
    echo "pre-push: the push touches crates/uorust/src/mir; running the core register's ratchet on CI's MIR" >&2
    scripts/mir/core-gate.sh "${cfg[@]}" \
      || { echo "pre-push: core-gate refuses: a body the core register records as translated is now residue" >&2; exit 1; }
  fi
done <<<"$pushed"
