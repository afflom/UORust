// MIR for `cmp::equal_arm` before ElaborateBoxDerefs

fn cmp::equal_arm(_1: cmp::Ordering) -> bool {
    debug o => _1;
    let mut _0: bool;
    let mut _2: i8;

    bb0: {
        PlaceMention(_1);
        _2 = discriminant(_1);
